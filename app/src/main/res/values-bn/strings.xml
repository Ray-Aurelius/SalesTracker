    <string name="pi_nothing">কোনো অ্যাকাউন্ট, অ্যানালিটিক্স, বিজ্ঞাপন, ট্র্যাকিং বা ক্র্যাশ রিপোর্ট নেই। অ্যাপের নির্মাতারা কখনো আপনার ডেটা দেখেন না।</string>
    <string name="pi_encrypted_t">এনক্রিপ্টেড</string>
    <string name="pi_encrypted">আপনার ডেটা ফাইল AES-256 দিয়ে এনক্রিপ্ট করা। কী ফোনের নিরাপদ হার্ডওয়্যারে থাকে এবং ফোনের বাইরে কপি করা যায় না।</string>
    <string name="pi_nobackup_t">ক্লাউডে স্বয়ংক্রিয় কপি নেই</string>
    <string name="pi_nobackup">এই অ্যাপের জন্য Google ক্লাউড ব্যাকআপ ও ফোন-থেকে-ফোন স্থানান্তর বন্ধ। আপনার ডেটা ফোন ছাড়ে শুধু সেই ব্যাকআপ ফাইলে, যা আপনি নিজে তৈরি করে নিজের পাসওয়ার্ড দিয়ে সুরক্ষিত করেন।</string>
