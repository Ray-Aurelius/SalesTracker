    <string name="pi_offline_t">Ở lại trên điện thoại</string>
    <string name="pi_offline">Ứng dụng không có quyền internet. Chính Android ngăn nó kết nối, nên dữ liệu của bạn không thể bị gửi đi đâu.</string>
    <string name="pi_nothing_t">Không thu thập gì</string>
    <string name="pi_nothing">Không tài khoản, không phân tích, không quảng cáo, không theo dõi, không báo cáo lỗi. Nhà phát triển không bao giờ thấy dữ liệu của bạn.</string>
    <string name="pi_encrypted_t">Được mã hóa</string>
    <string name="pi_encrypted">Tệp dữ liệu được mã hóa AES-256. Khóa nằm trong phần cứng bảo mật của điện thoại và không thể sao chép ra ngoài.</string>
    <string name="pi_nobackup_t">Không tự sao chép lên đám mây</string>
    <string name="pi_nobackup">Sao lưu đám mây Google và chuyển dữ liệu giữa các điện thoại bị tắt cho ứng dụng này. Dữ liệu chỉ rời điện thoại qua tệp sao lưu do chính bạn tạo, bảo vệ bằng mật khẩu của bạn.</string>
    <string name="pi_permissions_t">Các quyền được dùng</string>
    <string name="perm_notifications">Thông báo: để hiện lời nhắc lịch hẹn</string>
    <string name="perm_alarms">Báo thức và lời nhắc: để lời nhắc reo đúng giờ</string>
    <string name="perm_boot">Chạy khi khởi động: để đặt lại lời nhắc sau khi điện thoại khởi động lại</string>
    <string name="perm_biometric">Vân tay hoặc khuôn mặt: chỉ khi khóa ứng dụng bật. Android xác minh; ứng dụng không bao giờ thấy vân tay hay mã PIN của bạn.</string>
    <string name="pi_never_t">Không bao giờ yêu cầu</string>
    <string name="pi_never">Internet, danh bạ, vị trí, máy ảnh, micrô, ảnh và tệp, cuộc gọi, SMS.</string>
    <string name="agreement_title">Thỏa thuận người dùng</string>
    <string name="agreement_intro">Vui lòng đọc trước khi dùng Quota Vault. Thỏa thuận ngắn và giải thích ai chịu trách nhiệm về dữ liệu của bạn.</string>
    <string name="ag1_t">1. Dữ liệu thuộc về bạn</string>
    <string name="ag1">Mọi thứ bạn nhập chỉ được lưu trên điện thoại này. Ứng dụng không có truy cập internet, tài khoản hay máy chủ. Nhà phát triển không bao giờ nhận, xem, lưu trữ hay xử lý dữ liệu của bạn.</string>
    <string name="ag2_t">2. Bạn hoàn toàn chịu trách nhiệm về dữ liệu của mình</string>
    <string name="ag2">Bạn hoàn toàn chịu trách nhiệm về thông tin bạn nhập, kể cả thông tin cá nhân của khách hàng, và về việc giữ thông tin đó chính xác, an toàn và được sao lưu. Bạn có trách nhiệm tuân thủ luật, quy định và chính sách công ty áp dụng cho thông tin khách hàng bạn lưu, và có được mọi sự đồng ý cần thiết.</string>
    <string name="ag3_t">3. Sao lưu là trách nhiệm của bạn</string>
    <string name="ag3">Vì không có gì rời khỏi điện thoại, không ai khác có thể khôi phục dữ liệu cho bạn. Nếu điện thoại bị mất, bị đánh cắp, hư hỏng hoặc đặt lại, hoặc ứng dụng bị gỡ, dữ liệu sẽ mất trừ khi bạn đã sao lưu. Hãy sao lưu thường xuyên và giữ mật khẩu an toàn: mật khẩu bị quên không ai đặt lại hay khôi phục được.</string>
    <string name="ag4_t">4. Không chịu trách nhiệm về dữ liệu bị mất</string>
    <string name="ag4">Trong phạm vi tối đa pháp luật cho phép, nhà phát triển ứng dụng không chịu trách nhiệm về việc mất, hỏng hay lộ dữ liệu khách hàng, hồ sơ giao dịch hay bất kỳ dữ liệu ứng dụng nào khác, cũng như mọi thiệt hại, giao dịch bị lỡ, doanh thu bị mất hay tổn thất khác phát sinh từ việc dùng hoặc không thể dùng ứng dụng, dù do bất kỳ nguyên nhân nào.</string>
    <string name="ag5_t">5. Cung cấp \"nguyên trạng\"</string>
    <string name="ag5">Ứng dụng được cung cấp \"nguyên trạng\" và \"sẵn có\", không có bất kỳ bảo đảm nào, dù rõ ràng hay ngụ ý. Các số liệu như hoa hồng, tỷ lệ và tiến độ mục tiêu được tính cho tiện; hãy tự kiểm tra các số liệu quan trọng.</string>
    <string name="ag6_t">6. Bảo mật có giới hạn</string>
    <string name="ag6">Khóa ứng dụng, mã hóa và sao lưu giảm rủi ro rất nhiều, nhưng không hệ thống nào an toàn tuyệt đối. Hãy bật khóa màn hình điện thoại và cập nhật phần mềm.</string>
    <string name="ag7_t">7. Thay đổi thỏa thuận</string>
    <string name="ag7">Nếu thỏa thuận này thay đổi, ứng dụng sẽ yêu cầu bạn đọc và chấp nhận phiên bản mới trước khi tiếp tục.</string>
    <string name="ag_translation">Nếu bản dịch của thỏa thuận này khác với bản tiếng Anh, bản tiếng Anh được ưu tiên áp dụng.</string>
    <string name="agreement_checkbox">Tôi đã đọc và đồng ý với Thỏa thuận người dùng này, và hiểu rằng chỉ mình tôi chịu trách nhiệm sao lưu dữ liệu của mình.</string>
    <string name="agree">Đồng ý</string>
    <string name="decline">Từ chối</string>
    <string name="agreement_declined">Bạn cần chấp nhận Thỏa thuận người dùng để dùng ứng dụng.</string>
    <string name="guide_title">Cách sao lưu dữ liệu</string>
    <string name="guide_intro">Dữ liệu của bạn chỉ nằm trên điện thoại này. Bản sao lưu là bản sao đầy đủ, được mã hóa, giúp bạn khôi phục mọi thứ nếu điện thoại bị mất, hỏng, thay mới hoặc đặt lại.</string>
    <string name="guide_1">Mở Cài đặt (bánh răng ở góc trên bên phải) → Bảo mật và quyền riêng tư → Sao lưu vào tệp mã hóa.</string>
    <string name="guide_2">Chọn mật khẩu mạnh và ghi lại ở nơi an toàn, tách khỏi điện thoại. Nếu quên sẽ không thể khôi phục.</string>
    <string name="guide_3">Chọn nơi lưu tệp. Tốt nhất là nơi ngoài điện thoại này, như Google Drive hoặc máy tính, để bản sao lưu vẫn còn nếu mất điện thoại.</string>
    <string name="guide_4">Sao lưu thường xuyên. Mỗi bản sao lưu là bản sao đầy đủ; hãy giữ bản mới nhất. Ứng dụng sẽ nhắc khi bản sao lưu gần nhất đã cũ.</string>
    <string name="guide_5">Để khôi phục, trên điện thoại này hoặc điện thoại mới: cài ứng dụng, mở Cài đặt → Bảo mật và quyền riêng tư → Khôi phục từ bản sao lưu, chọn tệp và nhập mật khẩu.</string>
    <string name="guide_tip">Bản sao lưu được mã hóa AES-256. Không có mật khẩu, không ai mở được tệp, kể cả nhà phát triển ứng dụng.</string>
