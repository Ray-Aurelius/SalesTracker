<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen Quick add widget: four buttons that open the app straight to a form (after the app lock, if on).
     Shows no data at all. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingHorizontal="9dp"
    android:paddingVertical="10dp">
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="5dp"
        android:layout_marginBottom="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_quick_title"
        android:textColor="@color/widget_accent"
        android:textSize="14sp"
        android:textStyle="bold" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/quick_sale"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button"
            android:drawableTop="@drawable/ic_widget_sale"
            android:drawablePadding="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:minHeight="64dp"
            android:paddingHorizontal="2dp"
            android:paddingVertical="8dp"
            android:text="@string/widget_quick_sale"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/quick_client"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button"
            android:drawableTop="@drawable/ic_widget_client"
            android:drawablePadding="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:minHeight="64dp"
            android:paddingHorizontal="2dp"
            android:paddingVertical="8dp"
            android:text="@string/widget_quick_client"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/quick_expense"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button"
            android:drawableTop="@drawable/ic_widget_expense"
            android:drawablePadding="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:minHeight="64dp"
            android:paddingHorizontal="2dp"
            android:paddingVertical="8dp"
            android:text="@string/widget_quick_expense"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/quick_timer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button"
            android:drawableTop="@drawable/ic_widget_timer"
            android:drawablePadding="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:minHeight="64dp"
            android:paddingHorizontal="2dp"
            android:paddingVertical="8dp"
            android:text="@string/widget_quick_timer"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
