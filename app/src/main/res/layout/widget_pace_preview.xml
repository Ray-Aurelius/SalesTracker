<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview for the On track widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/on_track_title"
        android:textColor="@color/widget_accent"
        android:textSize="14sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text=""
        android:textColor="@color/widget_text"
        android:textSize="13sp"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/pace_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/pace_big"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:autoSizeMaxTextSize="30sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeTextType="uniform"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="+18% vs. last month"
            android:textColor="@color/widget_accent"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/pace_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/widget_pace_ahead"
            android:textColor="@color/widget_text"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/pace_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="12 days left"
            android:textColor="@color/widget_text"
            android:alpha="0.8"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
